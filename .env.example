# Group Chat App — Configuration Template
# Copy this file to .env and fill in your own values

PORT=5000 #port on which backend runs
# Backend (FastAPI WebSocket server)
BACKEND_PORT=5000 #port on which frontend send request

# Frontend (static file server)
FRONTEND_PORT=3000

# Room empty cleanup timeout in seconds (default 300 sec)
CLEANUP_TIMEOUT=300

# 256-bit AES-GCM group key (hex, 64 chars)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AES_GROUP_KEY=<generate-with-python-secrets-token-hex-32>

# Server-side HMAC-SHA256 secret for database tamper detection (hex, 64 chars)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=<generate-with-python-secrets-token-hex-32>

# ── Valkey (active-active in-memory DB) ───────────────────────────────────────
# Comma-separated list of Valkey instances.
# FIRST entry must be this backend's LOCAL Valkey (used for reads).
# ALL entries receive writes (active-active fan-out).
#
# Example for Sys2 (its own local Valkey first, then Sys3 and Sys4):
VALKEY_HOSTS=127.0.0.1:6379,172.17.0.96:6379,172.17.0.97:6379
#
# Example for Sys3:
# VALKEY_HOSTS=127.0.0.1:6379,172.17.0.95:6379,172.17.0.97:6379
#
# Example for Sys4:
# VALKEY_HOSTS=127.0.0.1:6379,172.17.0.95:6379,172.17.0.96:6379
#
# Deploy Valkey on each backend machine:
#   sudo apt-get install -y valkey
#   valkey-server --bind 0.0.0.0 --protected-mode no --daemonize yes
#   valkey-cli ping  # → PONG
