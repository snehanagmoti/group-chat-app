# Group Chat App — Configuration Template
# Copy this file to .env and fill in your own values

# ── Port Forwarding Convention ────────────────────────────────────────────────
# Internal port x000 maps to x273 (Sys1), x274 (Sys2), x275 (Sys3), x276 (Sys4).
# Examples:
#   Sys1: Ingress / LB (internal 4000 -> external 4273), Frontend (internal 3000 -> external 3273)
#   Sys2: Backend 1 (internal 5000 -> external 5274), Valkey Primary (internal 6000 -> external 6274)
#   Sys3: Backend 2 (internal 5000 -> external 5275), Valkey Replica (internal 6000 -> external 6275)
#   Sys4: Backend 3 (internal 5000 -> external 5276), Valkey Replica (internal 6000 -> external 6276)

# Internal port on which FastAPI / Gunicorn listens (default 5000)
PORT=5000

# Port reached by frontend / clients (e.g. 5274 on Sys2, 5275 on Sys3, 5276 on Sys4; or 4273 when using LB)
BACKEND_PORT=5000

# Frontend static server internal port (maps to 3273 on Sys1)
FRONTEND_PORT=3000

# Room empty cleanup timeout in seconds (default 300 sec)
CLEANUP_TIMEOUT=300

# 256-bit AES-GCM group key (hex, 64 chars)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AES_GROUP_KEY=<generate-with-python-secrets-token-hex-32>

# Server-side HMAC-SHA256 secret for database tamper detection (hex, 64 chars)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=<generate-with-python-secrets-token-hex-32>

# Valkey — Write client connects to Primary (Sys2)
# All mutations (POST /message, register, login) are sent here.
# Reached at Sys2 external port 6274 (or 127.0.0.1:6000 locally on Sys2)
VALKEY_PRIMARY_URL=redis://10.x.x.2:6274/0

# Valkey — Read client connects to the local Replica on this system.
# GET /feed reads from here — scales read throughput across all backends.
# Set per-system (locally connecting via internal port 6000 or external port):
#   Sys2: VALKEY_REPLICA_URL=redis://127.0.0.1:6000/0   (Sys2 is primary; internal 6000 / external 6274)
#   Sys3: VALKEY_REPLICA_URL=redis://127.0.0.1:6000/0   (Sys3 replica; internal 6000 / external 6275)
#   Sys4: VALKEY_REPLICA_URL=redis://127.0.0.1:6000/0   (Sys4 replica; internal 6000 / external 6276)
VALKEY_REPLICA_URL=redis://127.0.0.1:6000/0

# Fallback for single-node deployments (used if PRIMARY/REPLICA not set)
VALKEY_URL=redis://127.0.0.1:6000/0
