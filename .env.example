# Group Chat App — Configuration Template
# Copy this file to .env and fill in your own values

PORT=5000 #port on which backend runs
# Backend (FastAPI WebSocket server)
BACKEND_PORT=5000 #port on which frontend send request (this is due to port forwarding ocnfiguration, so which frontend send request on BACKEND_PORT, backend server running on PORT receives it and serve)

# Frontend (static file server)
FRONTEND_PORT=3000

# Room empty cleanup timeout in seconds (default 300 sec)
CLEANUP_TIMEOUT=300

# 256-bit AES-GCM group key (hex, 64 chars)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AES_GROUP_KEY=<generate-with-python-secrets-token-hex-32>

# Server-side HMAC-SHA256 secret for database tamper detection (hex, 64 chars)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=<generate-with-python-secrets-token-hex-32>

# Valkey — Write client connects to Primary (Sys2)
# All mutations (POST /message, register, login) are sent here.
VALKEY_PRIMARY_URL=redis://10.x.x.2:6274/0

# Valkey — Read client connects to the local Replica on this system.
# GET /feed reads from here — scales read throughput across all backends.
# Set per-system:
#   Sys2: VALKEY_REPLICA_URL=redis://10.x.x.2:6274/0   (Sys2 IS the primary — reads are fine here)
#   Sys3: VALKEY_REPLICA_URL=redis://10.x.x.3:6274/0
#   Sys4: VALKEY_REPLICA_URL=redis://10.x.x.4:6274/0
VALKEY_REPLICA_URL=redis://127.0.0.1:6274/0

# Fallback for single-node deployments (used if PRIMARY/REPLICA not set)
VALKEY_URL=redis://10.x.x.2:6274/0
