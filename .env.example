# Group Chat App — Configuration Template
# Copy this file to .env and fill in your own values

PORT=5000
# Backend (FastAPI WebSocket server)
# Public Sys1 load-balancer port advertised to browsers (4237 -> container 4000).
BACKEND_PORT=4237

# Sys1 load-balancer listen port inside the assigned container.
LB_PORT=4000
PUBLIC_LB_PORT=4237

# Frontend (static file server)
FRONTEND_PORT=3000
# Set to 0 only for local smoke tests; deployed Web Crypto requires HTTPS.
FRONTEND_TLS=1

# Room empty cleanup timeout in seconds (default 300 sec)
CLEANUP_TIMEOUT=300

# Authenticated browser session lifetime (seconds)
SESSION_TTL_SECONDS=43200

# Optional database path override used by tests or managed deployments
# CHAT_DB_PATH=/var/lib/pixelchat/chat.db

# 256-bit AES-GCM group key (hex, 64 chars)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AES_GROUP_KEY=<generate-with-python-secrets-token-hex-32>

# Server-side HMAC-SHA256 secret for database tamper detection (hex, 64 chars)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=<generate-with-python-secrets-token-hex-32>

# Deployment automation (do not commit LAB_SSH_PASSWORD)
LAB_HOST=10.1.75.53
LAB_USER=student
SYS1_SSH_PORT=2237
SYS2_SSH_PORT=2238
SYS3_SSH_PORT=2239
SYS4_SSH_PORT=2240
LAB_BACKEND_URLS=https://172.17.0.39:5000,https://172.17.0.40:5000,https://172.17.0.41:5000
# LAB_SSH_PASSWORD=<set-in-your-shell-or-enter-when-prompted>
# LAB_SSH_STRICT_HOST_KEY=1
